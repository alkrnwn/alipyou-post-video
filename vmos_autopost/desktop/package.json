{
  "name": "shopee-video-vmos",
  "version": "1.0.0",
  "description": "Shopee Video VMOS Auto-Post - Desktop Edition",
  "author": "Alipyou",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.alipyou.shopeevideosvmos",
    "productName": "Shopee Video VMOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shopee Video VMOS"
    },
    "portable": {
      "artifactName": "Shopee-Video-VMOS-Portable-v${version}.${ext}"
    }
  }
}
